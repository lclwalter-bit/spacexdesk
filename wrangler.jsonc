{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spcx-desk",
  "account_id": "6cdc990d20d1cd4f5fa546caae906fd0",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "spcx.nexus", "custom_domain": true },
    { "pattern": "www.spcx.nexus", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
